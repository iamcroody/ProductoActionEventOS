# --- Runtime data & backups (CONTAIN EVENT PII — never commit) ---
/data/
*.db
*.db-shm
*.db-wal

# --- Built binaries / release artifacts (publish via GitHub Releases, not git) ---
/dist/
/ActionEventOS
/ActionEventOS-macos
/ActionEventOS.exe

# --- Node (regenerated by `npm install`) ---
/web/node_modules/

# --- OS / tooling / test artifacts ---
.DS_Store
/.playwright-mcp/
/*.png

# NOTE: web/dist IS committed on purpose — it is embedded into the Go binary
# via //go:embed, so `go build ./cmd/eventpos` works straight from a clone.

# --- Testing & coverage artifacts (never ship) ---
cookies.txt
cover.out
cover.html
cobertura.html
RESULTADO_TESTS.txt
*.out
